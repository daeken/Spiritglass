{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProtocolCatalog",
  "description": "Schema catalog for all version 1 envelopes and method payloads.",
  "type": "object",
  "properties": {
    "action_invoke": {
      "$ref": "#/$defs/ActionInvoke"
    },
    "empty_params": {
      "$ref": "#/$defs/EmptyParams"
    },
    "initialize_params": {
      "$ref": "#/$defs/InitializeParams"
    },
    "initialize_result": {
      "$ref": "#/$defs/InitializeResult"
    },
    "message": {
      "$ref": "#/$defs/Message"
    },
    "module_description": {
      "$ref": "#/$defs/ModuleDescription"
    },
    "snapshot": {
      "$ref": "#/$defs/Snapshot"
    },
    "state_changed": {
      "$ref": "#/$defs/StateChanged"
    },
    "state_publish": {
      "$ref": "#/$defs/StatePublish"
    },
    "view": {
      "$ref": "#/$defs/Widget"
    },
    "view_get": {
      "$ref": "#/$defs/ViewGet"
    }
  },
  "required": [
    "message",
    "initialize_params",
    "initialize_result",
    "empty_params",
    "module_description",
    "view_get",
    "view",
    "action_invoke",
    "state_publish",
    "snapshot",
    "state_changed"
  ],
  "$defs": {
    "ActionDefinition": {
      "type": "object",
      "properties": {
        "arguments": {
          "$ref": "#/$defs/DataType"
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "arguments"
      ]
    },
    "ActionInvoke": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "arguments": true
      },
      "additionalProperties": false,
      "required": [
        "action",
        "arguments"
      ]
    },
    "DataType": {
      "description": "A deliberately small, closed schema vocabulary. Every object property is required.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "number"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "integer"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "items": {
              "$ref": "#/$defs/DataType"
            },
            "type": {
              "type": "string",
              "const": "array"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "items"
          ]
        },
        {
          "type": "object",
          "properties": {
            "properties": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/DataType"
              }
            },
            "type": {
              "type": "string",
              "const": "object"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "properties"
          ]
        }
      ]
    },
    "EmptyParams": {
      "type": "object",
      "additionalProperties": false
    },
    "Failure": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/RpcError"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RpcId"
            },
            {
              "type": "null"
            }
          ]
        },
        "jsonrpc": {
          "$ref": "#/$defs/RpcVersion"
        }
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "error"
      ]
    },
    "InitializeParams": {
      "type": "object",
      "properties": {
        "protocol_versions": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "protocol_versions"
      ]
    },
    "InitializeResult": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "protocol_version"
      ]
    },
    "Message": {
      "anyOf": [
        {
          "$ref": "#/$defs/Request"
        },
        {
          "$ref": "#/$defs/Notification"
        },
        {
          "$ref": "#/$defs/Success"
        },
        {
          "$ref": "#/$defs/Failure"
        }
      ]
    },
    "ModuleDescription": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionDefinition"
          }
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceDefinition"
          }
        },
        "view_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "sources",
        "actions",
        "view_id"
      ]
    },
    "ModuleHealth": {
      "type": "string",
      "enum": [
        "starting",
        "ready",
        "unavailable"
      ]
    },
    "Notification": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/RpcVersion"
        },
        "method": {
          "type": "string"
        },
        "params": {
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "method"
      ]
    },
    "Property": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "literal"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "binding"
            },
            "path": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "path"
          ]
        }
      ]
    },
    "Property2": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "literal"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "binding"
            },
            "path": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "path"
          ]
        }
      ]
    },
    "Property3": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "literal"
            },
            "value": {
              "$ref": "#/$defs/Status"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "binding"
            },
            "path": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "path"
          ]
        }
      ]
    },
    "Request": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/RpcId"
        },
        "jsonrpc": {
          "$ref": "#/$defs/RpcVersion"
        },
        "method": {
          "type": "string"
        },
        "params": {
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method"
      ]
    },
    "RpcError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "RpcId": {
      "anyOf": [
        {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        {
          "type": "string"
        }
      ]
    },
    "RpcVersion": {
      "type": "string",
      "enum": [
        "2.0"
      ]
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "diagnostic": {
          "type": [
            "string",
            "null"
          ]
        },
        "health": {
          "$ref": "#/$defs/ModuleHealth"
        },
        "module": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModuleDescription"
            },
            {
              "type": "null"
            }
          ]
        },
        "protocol_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SourceState"
          }
        },
        "view": {
          "anyOf": [
            {
              "$ref": "#/$defs/Widget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "sources",
        "health"
      ]
    },
    "SourceDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "schema": {
          "$ref": "#/$defs/DataType"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "schema"
      ]
    },
    "SourceState": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/SourceStatus"
        },
        "updated_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "value": true
      },
      "additionalProperties": false,
      "required": [
        "value",
        "status",
        "revision",
        "updated_at_ms"
      ]
    },
    "SourceStatus": {
      "type": "string",
      "enum": [
        "available",
        "stale"
      ]
    },
    "StateChanged": {
      "type": "object",
      "properties": {
        "diagnostic": {
          "type": [
            "string",
            "null"
          ]
        },
        "health": {
          "$ref": "#/$defs/ModuleHealth"
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SourceState"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "sources",
        "health"
      ]
    },
    "StatePublish": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "value": true
      },
      "additionalProperties": false,
      "required": [
        "source",
        "value"
      ]
    },
    "Status": {
      "type": "string",
      "enum": [
        "clear",
        "notice",
        "urgent",
        "emergency",
        "unknown"
      ]
    },
    "Success": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/RpcId"
        },
        "jsonrpc": {
          "$ref": "#/$defs/RpcVersion"
        },
        "result": true
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "result"
      ]
    },
    "ViewGet": {
      "type": "object",
      "properties": {
        "view_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "view_id"
      ]
    },
    "Widget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Widget"
              }
            },
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "v_stack"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "children"
          ]
        },
        {
          "type": "object",
          "properties": {
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Widget"
              }
            },
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "h_stack"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "children"
          ]
        },
        {
          "type": "object",
          "properties": {
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Widget"
              }
            },
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "card"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "title",
            "children"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            },
            "value": {
              "$ref": "#/$defs/Property"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "metric"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            },
            "value": {
              "$ref": "#/$defs/Property2"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "label",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "status"
            },
            "value": {
              "$ref": "#/$defs/Property3"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "label",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string"
            },
            "arguments": true,
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "button"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "label",
            "action",
            "arguments"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "divider"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ]
        }
      ]
    }
  }
}
